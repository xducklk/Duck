<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1c1c1d">
<title>the duck</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;800&display=swap">
<style>
  /* Layout: one frosted card centered on a grainy grayscale field; translucent profile block above, white social strip below. */
  :root {
    --ground: #3b3b3d;
    --ground-deep: #1c1c1d;
    --glass: rgba(255, 255, 255, 0.16);
    --glass-edge: rgba(255, 255, 255, 0.28);
    --ink: #ffffff;
    --ink-soft: rgba(255, 255, 255, 0.88);
    --strip: #ffffff;
    --chip: #e6e6e6;
    --chip-ink: #111111;
    /* BACKGROUND: your image goes here as url("data:image/jpeg;base64,...") */
    --bg-image: url("data:image/jpeg;base64,");
    --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-display: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body {
    min-height: 100vh;
    margin: 0;
    padding-block: 40px;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    font-family: var(--font-body);
    color: var(--ink);
    background-color: var(--ground-deep);
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='420' height='420'><filter id='g' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='0.012 0.02' numOctaves='4' seed='7'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0'/><feFuncR type='linear' slope='1.5' intercept='-0.15'/><feFuncG type='linear' slope='1.5' intercept='-0.15'/><feFuncB type='linear' slope='1.5' intercept='-0.15'/></feComponentTransfer></filter><rect width='100%' height='100%' filter='url(%23g)' opacity='0.9'/></svg>"),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' seed='3'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.22'/></svg>"),
      radial-gradient(120% 80% at 50% 0%, var(--ground), var(--ground-deep));
    background-size: 700px 700px, 220px 220px, cover;
    background-attachment: fixed;
  }
  .bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.5)), var(--bg-image);
    background-size: cover;
    background-position: center;
    pointer-events: none;
  }
  .overlay {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 8px);
    left: max(8px, env(safe-area-inset-left, 0px));
    width: 124px;
    height: auto;
    z-index: 2;
    mix-blend-mode: screen; /* black in the video becomes transparent */
    pointer-events: none;
  }
  .card, .foot { position: relative; z-index: 1; }
  .card {
    width: 100%;
    max-width: 460px;
  }
  .profile {
    padding: 8px 20px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .avatar {
    width: 116px;
    height: 116px;
    border-radius: 50%;
    border: 4px solid var(--ink);
    overflow: hidden;
    background: radial-gradient(circle at 40% 30%, #8d8d8f, #2b2b2d);
    display: block;
  }
  .avatar img, .avatar svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  h1 {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 12vw, 3.4rem);
    letter-spacing: 0;
    line-height: 1.1;
  }
  .profile p {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--ink-soft);
    text-wrap: balance;
  }
  .profile p + p { margin-top: 1.1rem; }
  .profile h1 + p { margin-top: 1.4rem; }
  .profile strong { color: var(--ink); font-weight: 800; }
  .cta {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 30px;
    border-radius: 999px;
    border: 1px solid var(--glass-edge);
    background: rgba(255, 255, 255, 0.14);
    color: var(--ink);
    font: inherit;
    font-size: 1.15rem;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .cta:hover { background: rgba(255, 255, 255, 0.26); transform: translateY(-1px); }
  .cta svg { width: 26px; height: 26px; flex: none; }
  .socials {
    padding: 12px 16px;
    background: transparent;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .socials a {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    border: 1px solid rgba(255, 255, 255, 0.6);
    display: grid;
    place-items: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover { background: rgba(255, 255, 255, 0.18); transform: translateY(-2px); }
  .socials svg { width: 22px; height: 22px; }
  a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
    .foot {
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
  }
  /* Entrance: each piece drops in from above, one after another. */
  @keyframes drop {
    from { opacity: 0; transform: translateY(-36px); }
    to { opacity: 1; transform: none; }
  }
  .profile > *, .socials, .foot {
    animation: drop 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
  }
  .profile > :nth-child(1) { animation-delay: 0.05s; }
  .profile > :nth-child(2) { animation-delay: 0.2s; }
  .profile > :nth-child(3) { animation-delay: 0.35s; }
  .profile > :nth-child(4) { animation-delay: 0.5s; }
  .profile > :nth-child(5) { animation-delay: 0.65s; }
  .socials { animation-delay: 0.8s; }
  .foot { animation-delay: 0.95s; }
  @media (prefers-reduced-motion: reduce) {
    .cta, .socials a { transition: none; }
    .profile > *, .socials, .foot { animation: none; }
  }
</style>
</head>
<body>

